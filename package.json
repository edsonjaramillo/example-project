{
	"name": "example-project",
	"private": true,
	"license": "MIT",
	"author": "Edson Jaramillo <edsonajaramillo@gmail.com>",
	"type": "module",
	"module": "src/index.ts",
	"scripts": {
		"check": "bun run typecheck && bun run lint && bun run format:check",
		"effect:diagnostics": "effect-tsgo diagnostics --project tsconfig.json",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"prepare": "lefthook install",
		"start": "bun src/index.ts",
		"test": "bun test",
		"typecheck": "effect-tsgo tsrs -p ."
	},
	"dependencies": {
		"@effect/platform-bun": "^4.1.5",
		"effect": "^4.1.5"
	},
	"devDependencies": {
		"@cloudflare/oxlint-config": "^0.2.0",
		"@effect/tsgo": "0.73.4",
		"@types/bun": "^1.4.5",
		"@types/node": "^26.6.10",
		"lefthook": "^2.2.3",
		"oxfmt": "^0.80.0",
		"oxlint": "^1.95.0",
		"tsrs": "7.1.0-beta.tsrs4"
	}
}
